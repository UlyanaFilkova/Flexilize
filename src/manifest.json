{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "version": "1.1.1",
  "name": "Context Translator",
  "description": "Определяет язык выделенного текста, переводит его на русский, озвучивает и сохраняет контекст.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://api.mymemory.translated.net/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.datamuse.com/*",
    "https://en.wiktionary.org/*",
    "https://clients5.google.com/*",
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*"
  ],
  "background": {
    "chromium:service_worker": "background.ts",
    "firefox:scripts": ["background.ts"]
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "chromium:action": {
    "default_title": "Сохранённые переводы",
    "default_popup": "popup/index.html"
  },
  "firefox:browser_action": {
    "default_title": "Сохранённые переводы",
    "default_popup": "popup/index.html"
  },
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "context-translator@flexilize.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.ts"],
      "run_at": "document_idle"
    }
  ]
}
