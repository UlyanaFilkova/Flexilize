{
  "manifest_version": 3,
  "name": "Context Translator",
  "version": "1.0.0",
  "description": "Переводит выделенный текст, озвучивает его и сохраняет контекст.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://api.mymemory.translated.net/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.datamuse.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Сохранённые переводы",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
