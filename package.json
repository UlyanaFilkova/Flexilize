{
  "private": true,
  "name": "context-translator",
  "version": "1.1.0",
  "description": "Контекстный переводчик выделенного текста на русский язык для Chrome и Firefox.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bash ./scripts/run-with-project-node.sh node_modules/extension/bin/extension.cjs dev",
    "dev:chrome": "bash ./scripts/run-with-project-node.sh node_modules/extension/bin/extension.cjs dev --browser chrome",
    "dev:firefox": "bash ./scripts/run-with-project-node.sh node_modules/extension/bin/extension.cjs dev --browser firefox",
    "build": "bash ./scripts/run-with-project-node.sh node_modules/extension/bin/extension.cjs build",
    "build:chrome": "bash ./scripts/run-with-project-node.sh node_modules/extension/bin/extension.cjs build --browser chrome",
    "build:firefox": "bash ./scripts/run-with-project-node.sh node_modules/extension/bin/extension.cjs build --browser firefox",
    "zip:chrome": "bash ./scripts/run-with-project-node.sh node_modules/extension/bin/extension.cjs build --browser chrome --zip",
    "zip:firefox": "bash ./scripts/run-with-project-node.sh node_modules/extension/bin/extension.cjs build --browser firefox --zip",
    "preview": "bash ./scripts/run-with-project-node.sh node_modules/extension/bin/extension.cjs preview",
    "typecheck": "bash ./scripts/run-with-project-node.sh node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.3",
    "addons-linter": "^10.14.0",
    "extension": "^4.1.33",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@10.9.3"
}
